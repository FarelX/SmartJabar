# SMART JABAR Frontend — Environment Configuration Template (Development)

# Environment Mode: development | staging | production
VITE_APP_ENV=development

# Backend Laravel REST API Base URL
VITE_API_BASE_URL=http://localhost:8000/api

# Keycloak SSO Login Entrypoint (Authorization Code flow)
VITE_SSO_LOGIN_URL=https://sso.jabarprov.go.id/realms/ssojabar/protocol/openid-connect/auth?response_type=code&client_id=smart-jabar&redirect_uri=http://localhost:8000/api/auth/sso/callback

# Feature Flags
# Enable mock role switcher (Admin <-> ASN) in header for local UI testing
VITE_ENABLE_MOCK_AUTH=true
