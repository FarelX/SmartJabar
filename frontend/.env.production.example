# SMART JABAR Frontend — Production Environment Configuration Template

# Environment Mode
VITE_APP_ENV=production

# Backend Laravel REST API Base URL (Production Domain)
VITE_API_BASE_URL=https://smart.jabarprov.go.id/api

# Keycloak SSO Login Entrypoint
VITE_SSO_LOGIN_URL=https://sso.jabarprov.go.id/realms/ssojabar/protocol/openid-connect/auth?response_type=code&client_id=smart-jabar&redirect_uri=https://smart.jabarprov.go.id/api/auth/sso/callback

# Feature Flags
# MUST be false in production to disable mock testing switchers
VITE_ENABLE_MOCK_AUTH=false
